<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Steps fallback via SensorManager (Android 10+). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Runtime notification permission (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional Health Connect read access. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <!-- Needed to detect / launch Health Connect on Android 13-. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:name=".BioQuestApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_bio_core"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BioQuest">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BioQuest">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rationale activity for Health Connect (optional integration). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Bio Core 4x2 widget -->
        <receiver
            android:name=".widget.BioCoreWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bio_core_widget_info" />
        </receiver>

        <!-- Quick Action 1x1 widget -->
        <receiver
            android:name=".widget.QuickActionWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_action_widget_info" />
        </receiver>

        <!-- Logs a habit from a reminder notification action button -->
        <receiver
            android:name=".notifications.HabitLogReceiver"
            android:exported="false" />

    </application>
</manifest>
